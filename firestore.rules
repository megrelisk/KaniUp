rules_version = '2';
// All data access goes through the Next.js server (Admin SDK), which enforces
// KaniUp's role/permission model. Browsers only listen to change pings.
service cloud.firestore {
  match /databases/{database}/documents {
    match /pings/{id} {
      allow read: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
