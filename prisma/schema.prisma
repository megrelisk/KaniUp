generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────

/// System roles. Display names are themed (see src/lib/roles.ts) and new roles
/// cannot be created — admins only edit what each role is allowed to do.
enum Role {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  GUEST
}

enum Permission {
  VIEW
  CREATE_TASK
  EDIT_TASK
  DELETE_TASK
  ASSIGN
  CHANGE_STATUS
  APPROVE_DONE
  EDIT_XP
  COMMENT
  INVITE
  MANAGE_STRUCTURE
  MANAGE_STATUSES
  MANAGE_FIELDS
  MANAGE_ROLES
}

enum ScopeType {
  GALAXY
  FOLDER
  PLANET
}

enum Difficulty {
  EASY
  NORMAL
  HARD
  EPIC
  LEGENDARY
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum StatusKind {
  BACKLOG
  OPEN
  ACTIVE
  REVIEW
  DONE
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  CHECKBOX
  URL
}

// ─── Auth.js ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  avatar        String    @default("polar-bear")
  locale        String    @default("ka")
  role          Role      @default(MEMBER)
  xp            Int       @default(0)
  streak        Int       @default(0)
  bestStreak    Int       @default(0)
  lastStreakDay DateTime? @db.Date
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  grants        RoleGrant[]
  assignments   TaskAssignee[]
  createdTasks  Task[]           @relation("TaskCreator")
  comments      Comment[]
  reactions     CommentReaction[]
  xpEvents      XpEvent[]
  achievements  UserAchievement[]
  notifications Notification[]
  activity      ActivityLog[]
  apiKeys       ApiKey[]
  invitesSent   Invitation[]     @relation("Inviter")
  attachments   Attachment[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ─── Structure: Galaxy → Folder (Solar system) → Planet → Folder → Task ──

model Galaxy {
  id        String    @id @default(cuid())
  name      String
  color     String    @default("#7c5cff")
  icon      String    @default("🌌")
  position  Int       @default(0)
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  folders   Folder[]
  planets   Planet[]
}

/// "Solar system". Lives either directly in a galaxy (galaxyId) or inside a
/// planet (planetId); parentId allows unlimited nesting.
model Folder {
  id        String    @id @default(cuid())
  name      String
  color     String?
  position  Int       @default(0)
  galaxyId  String
  planetId  String?
  parentId  String?
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  galaxy    Galaxy    @relation(fields: [galaxyId], references: [id], onDelete: Cascade)
  planet    Planet?   @relation("PlanetFolders", fields: [planetId], references: [id], onDelete: Cascade)
  parent    Folder?   @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]  @relation("FolderTree")
  planets   Planet[]  @relation("FolderPlanets")
  tasks     Task[]

  @@index([galaxyId, parentId])
  @@index([planetId])
}

model Planet {
  id           String        @id @default(cuid())
  name         String
  description  String?
  color        String        @default("#22d3ee")
  icon         String        @default("🪐")
  position     Int           @default(0)
  galaxyId     String
  folderId     String?
  createdAt    DateTime      @default(now())
  deletedAt    DateTime?
  galaxy       Galaxy        @relation(fields: [galaxyId], references: [id], onDelete: Cascade)
  folder       Folder?       @relation("FolderPlanets", fields: [folderId], references: [id], onDelete: SetNull)
  innerFolders Folder[]      @relation("PlanetFolders")
  statuses     Status[]
  tasks        Task[]
  tags         Tag[]
  customFields CustomField[]

  @@index([galaxyId, folderId])
}

model Status {
  id       String     @id @default(cuid())
  planetId String
  name     String
  color    String
  kind     StatusKind
  position Int
  planet   Planet     @relation(fields: [planetId], references: [id], onDelete: Cascade)
  tasks    Task[]

  @@index([planetId, position])
}

// ─── Tasks ───────────────────────────────────────────────────────────────

model Task {
  id          String     @id @default(cuid())
  number      Int        @default(autoincrement())
  title       String
  description String?
  planetId    String
  folderId    String?
  parentId    String?
  statusId    String
  difficulty  Difficulty @default(NORMAL)
  priority    Priority   @default(NORMAL)
  /// Auto-calculated from difficulty × priority unless xpOverride is set.
  xp          Int
  xpOverride  Boolean    @default(false)
  startDate   DateTime?
  dueDate     DateTime?
  position    Float      @default(0)
  creatorId   String
  completedAt DateTime?
  reviewedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  planet       Planet             @relation(fields: [planetId], references: [id], onDelete: Cascade)
  folder       Folder?            @relation(fields: [folderId], references: [id], onDelete: SetNull)
  parent       Task?              @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks     Task[]             @relation("Subtasks")
  status       Status             @relation(fields: [statusId], references: [id])
  creator      User               @relation("TaskCreator", fields: [creatorId], references: [id])
  assignees    TaskAssignee[]
  tags         TaskTag[]
  comments     Comment[]
  attachments  Attachment[]
  fieldValues  CustomFieldValue[]
  xpEvents     XpEvent[]
  activity     ActivityLog[]
  notifications Notification[]

  @@index([planetId, statusId, position])
  @@index([parentId])
  @@index([dueDate])
}

model TaskAssignee {
  taskId     String
  userId     String
  /// Share of the task XP in percent (0–100). Split evenly by default.
  xpShare    Int      @default(100)
  assignedAt DateTime @default(now())
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model Tag {
  id       String    @id @default(cuid())
  planetId String
  name     String
  color    String
  planet   Planet    @relation(fields: [planetId], references: [id], onDelete: Cascade)
  tasks    TaskTag[]

  @@unique([planetId, name])
}

model TaskTag {
  taskId String
  tagId  String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

model Attachment {
  id         String   @id @default(cuid())
  taskId     String?
  commentId  String?
  uploaderId String
  name       String
  mime       String
  size       Int
  url        String
  createdAt  DateTime @default(now())
  task       Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comment    Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploader   User     @relation(fields: [uploaderId], references: [id])
}

model CustomField {
  id       String             @id @default(cuid())
  planetId String
  name     String
  type     CustomFieldType
  options  String[]
  position Int                @default(0)
  planet   Planet             @relation(fields: [planetId], references: [id], onDelete: Cascade)
  values   CustomFieldValue[]
}

model CustomFieldValue {
  taskId  String
  fieldId String
  value   String
  task    Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  field   CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@id([taskId, fieldId])
}

// ─── Comments (task messenger) ───────────────────────────────────────────

model Comment {
  id          String            @id @default(cuid())
  taskId      String
  authorId    String?
  parentId    String?
  body        String
  /// System messages ("Nika moved this to Review") have no author.
  system      Boolean           @default(false)
  mentions    String[]
  editedAt    DateTime?
  deletedAt   DateTime?
  createdAt   DateTime          @default(now())
  task        Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author      User?             @relation(fields: [authorId], references: [id])
  parent      Comment?          @relation("Replies", fields: [parentId], references: [id], onDelete: SetNull)
  replies     Comment[]         @relation("Replies")
  reactions   CommentReaction[]
  attachments Attachment[]

  @@index([taskId, createdAt])
}

model CommentReaction {
  commentId String
  userId    String
  emoji     String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId, emoji])
}

// ─── Roles & permissions ─────────────────────────────────────────────────

/// Gives a user a role inside a galaxy / folder / planet. The most specific
/// grant on the path to a task wins over the user's global role.
model RoleGrant {
  id        String    @id @default(cuid())
  userId    String
  role      Role
  scopeType ScopeType
  scopeId   String
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scopeType, scopeId])
  @@index([scopeType, scopeId])
}

/// Overrides the default permission matrix. scopeType/scopeId null = global.
model RolePermission {
  id         String     @id @default(cuid())
  role       Role
  permission Permission
  allowed    Boolean
  scopeType  ScopeType?
  scopeId    String?

  @@unique([role, permission, scopeType, scopeId])
}

model Invitation {
  id         String     @id @default(cuid())
  email      String
  role       Role
  scopeType  ScopeType?
  scopeId    String?
  token      String     @unique
  inviterId  String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime   @default(now())
  inviter    User       @relation("Inviter", fields: [inviterId], references: [id])

  @@index([email])
}

// ─── Gamification ────────────────────────────────────────────────────────

model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  taskId    String?
  amount    Int
  reason    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model UserAchievement {
  userId     String
  key        String
  unlockedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
}

// ─── Activity, notifications, API ────────────────────────────────────────

model ActivityLog {
  id        String   @id @default(cuid())
  actorId   String?
  taskId    String?
  action    String
  data      Json?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  taskId    String?
  type      String
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  prefix     String
  hash       String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
