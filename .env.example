# ── Firebase web app config (Firebase console → Project settings → Your apps) ──
NEXT_PUBLIC_FIREBASE_API_KEY="demo-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="demo-kaniup.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="demo-kaniup"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="demo-kaniup.appspot.com"
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
# Web push: Firebase console → Project settings → Cloud Messaging → Web Push certificates
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# Local development against the Firebase Emulator Suite (`npm run emulators`).
# Remove these four lines in production.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS="true"
FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
FIREBASE_STORAGE_EMULATOR_HOST="127.0.0.1:9199"

# Production only: service account JSON (one line) for the Admin SDK.
# On Firebase App Hosting / Cloud Run the default credentials are used instead.
FIREBASE_SERVICE_ACCOUNT=""

APP_URL="http://localhost:3000"
# Comma-separated emails that become the Owner on first login
OWNER_EMAILS="s.kartozia@kani.ge"

# SMTP for notification emails. Empty = emails are printed to the server console.
# Gmail: create an App Password (Google Account → Security → 2-Step Verification → App passwords)
#   SMTP_URL="smtps://you%40gmail.com:APP_PASSWORD_WITHOUT_SPACES@smtp.gmail.com:465"
#   MAIL_FROM="KaniUp <you@gmail.com>"   (Gmail only sends from your own address)
SMTP_URL=""
MAIL_FROM="KaniUp <noreply@kani.ge>"

# SMS — leave empty until the Georgian provider's API key arrives (messages are logged instead).
#   SMS_PROVIDER="smsoffice"  + SMS_API_KEY + SMS_SENDER
#   SMS_PROVIDER="http"       + SMS_API_URL="https://…?key={key}&to={to}&from={sender}&text={text}"
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_SENDER="KaniUp"
SMS_API_URL=""

# Protects /api/cron/deadlines (called every morning by Cloud Scheduler). Any long random string.
CRON_SECRET="change-me"
